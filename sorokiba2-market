  { id: 'cha', name: 'Chá gelado', aisle: 'bebidas', price: 5, heal: 3, icon: '🍵' },
  { id: 'refri', name: 'Refrigerante', aisle: 'bebidas', price: 6, heal: 1, icon: '🥤' },
  { id: 'arroz', name: 'Arroz 1 kg', aisle: 'mercearia', price: 14, heal: 0, icon: '🍚' },
  { id: 'feijao', name: 'Feijão 1 kg', aisle: 'mercearia', price: 9, heal: 0, icon: '🫘' },
