'use strict';
// Sorokiba 2 – Mercado. Mesma regra do Banco, do Hospital e da Delegacia: preço, oferta, saldo e despensa são
// decididos e gravados no servidor, em transação; o cliente só mostra o carrinho e pede a compra.
//
//   • catálogo fixo (PRODUCTS) em sete corredores; o servidor recalcula todos os preços;
//   • ofertas do dia: 4 produtos com desconto, sorteados por dia (igual para todos), limite de 3 unidades por morador;
//   • Cartão Sorokiba: 1 ponto a cada R$ 10 pagos; 100 pontos viram R$ 10 de desconto numa compra de R$ 20 ou mais;
//   • o dinheiro das compras vai para o tesouro da cidade (extrato `mercado`);
//   • despensa: comprar enche a despensa (até 20 de cada); comer devolve saúde pelo mesmo relógio de saúde do Hospital.
const crypto = require('crypto');
const db = require('./sorokiba2-db');
const city = require('./sorokiba2-city');
const hospital = require('./sorokiba2-hospital');

// SK2_MARKET_TIME_SCALE=0.001 acelera a virada do "dia" das ofertas para testar. Em produção: 1.
const SCALE = (() => { const n = Number(process.env.SK2_MARKET_TIME_SCALE); return n > 0 && n <= 1 ? n : 1; })();
const DAY_MS = Math.max(1000, Math.round(86400e3 * SCALE));

const MARKET = Object.freeze({
  LINES_MAX: 12, QTY_MAX: 10, UNITS_MAX: 30, PANTRY_MAX: 20,
  DEAL_COUNT: 4, DEAL_LIMIT: 3, DEAL_PCTS: [15, 20, 25, 30],
  POINT_EVERY: 10, REDEEM_POINTS: 100, REDEEM_VALUE: 10, REDEEM_MIN_TOTAL: 20,
  EAT_COOLDOWN_S: 20, ORDERS_KEEP: 5,
});
const AISLES = Object.freeze({
  hortifruti: 'Hortifruti', padaria: 'Padaria', laticinios: 'Laticínios', bebidas: 'Bebidas',
  mercearia: 'Mercearia', congelados: 'Congelados', limpeza: 'Limpeza',
});
// heal = saúde que o produto devolve ao ser comido (0 = não comestível).
const PRODUCTS = Object.freeze([
  { id: 'maca', name: 'Maçã', aisle: 'hortifruti', price: 6, heal: 5, icon: '🍎' },
  { id: 'banana', name: 'Banana prata', aisle: 'hortifruti', price: 5, heal: 5, icon: '🍌' },
  { id: 'tomate', name: 'Tomate', aisle: 'hortifruti', price: 7, heal: 4, icon: '🍅' },
  { id: 'alface', name: 'Alface crespa', aisle: 'hortifruti', price: 4, heal: 3, icon: '🥬' },
  { id: 'cenoura', name: 'Cenoura', aisle: 'hortifruti', price: 3, heal: 3, icon: '🥕' },
  { id: 'pao', name: 'Pão francês', aisle: 'padaria', price: 3, heal: 4, icon: '🥖' },
  { id: 'bolo', name: 'Bolo de milho', aisle: 'padaria', price: 9, heal: 6, icon: '🍰' },
  { id: 'croissant', name: 'Croissant', aisle: 'padaria', price: 7, heal: 5, icon: '🥐' },
  { id: 'leite', name: 'Leite integral', aisle: 'laticinios', price: 6, heal: 4, icon: '🥛' },
  { id: 'iogurte', name: 'Iogurte natural', aisle: 'laticinios', price: 5, heal: 4, icon: '🍦' },
  { id: 'queijo', name: 'Queijo minas', aisle: 'laticinios', price: 12, heal: 5, icon: '🧀' },
  { id: 'suco', name: 'Suco de laranja', aisle: 'bebidas', price: 7, heal: 5, icon: '🧃' },
