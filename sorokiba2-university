const hasOwn = (o, k) => typeof k === 'string' && Object.prototype.hasOwnProperty.call(o, k);
const passValid = (pass, now = Date.now()) => !!pass && Number(pass.expiresAt) > now;
// Acesso a uma zona: { ok, why }. Só a Portaria é pública; o resto depende da carteirinha.
function zoneAccess(zone, pass, student, now = Date.now()) {
  if (!hasOwn(ZONES, zone)) return { ok: false, why: 'Zona desconhecida.' };
  if (zone === 'portaria') return { ok: true, why: '' };
  if (!pass) return { ok: false, why: 'Retire a sua carteirinha na recepção para entrar no campus.' };
  if (!passValid(pass, now)) return { ok: false, why: 'Sua carteirinha venceu. Renove na recepção.' };
  if (pass.role === 'visitante') {
    const p = VISIT_PURPOSES[pass.purpose];
    return p && p.zones.includes(zone) ? { ok: true, why: '' } : { ok: false, why: `Visitante (${p ? p.label.toLowerCase() : 'sem motivo'}): ${ZONES[zone]} é área restrita.` };
  }
  const allowed = ROLE_ZONES[pass.role] || [];
  if (!allowed.includes(zone)) return { ok: false, why: `${ZONES[zone]}: acesso restrito a ${zone === 'professores' || zone === 'reitoria' || zone === 'provas' ? 'professores' : 'outros perfis'}.` };
  if (zone === 'labs' && pass.role === 'aluno' && !(student && student.status === 'ativo' && LAB_COURSES.includes(student.course))) return { ok: false, why: 'Os laboratórios são de Computação e Engenharia Civil.' };
  if (zone === 'salas' && pass.role === 'aluno' && !(student && student.status === 'ativo')) return { ok: false, why: 'As aulas são para alunos com matrícula ativa.' };
  return { ok: true, why: '' };
}
const buildAccess = (pass, student, now) => Object.fromEntries(Object.keys(ZONES).map(z => [z, zoneAccess(z, pass, student, now)]));
function canteenPrice(itemId, role) {
  const it = CANTEEN_BY_ID[itemId]; if (!it) return null;
  const pct = DISCOUNT[role] || 0;
  return Math.max(1, Math.round(it.price * (100 - pct) / 100));
}
// Corrige respostas: `answers` precisa ter um índice válido por pergunta.
function grade(questions, answers) {
  if (!Array.isArray(answers) || answers.length !== questions.length) return { err: 'Responda todas as perguntas.' };
  const review = [];
  for (let i = 0; i < questions.length; i++) {
    const a = answers[i];
    if (!Number.isInteger(a) || a < 0 || a >= questions[i].options.length) return { err: 'Resposta inválida.' };
    review.push(a === questions[i].a);
  }
  return { correct: review.filter(Boolean).length, total: questions.length, review };
}
const quizPassed = correct => correct >= UNI.QUIZ_PASS;
// Próximo módulo liberado de um curso: os módulos são sequenciais.
function moduleUnlocked(moduleId, passedSet) {
  const m = MODULE_BY_ID[moduleId]; if (!m) return false;
  const list = COURSES[m.course].modules, i = list.findIndex(x => x.id === moduleId);
  return i === 0 || passedSet.has(list[i - 1].id);
}
function courseStatus(course, passedSet) {
  const c = COURSES[course];
  const disciplines = c.disciplines.map(d => ({ id: d.id, name: d.name, done: d.modules.every(m => passedSet.has(m.id)), modules: d.modules.map(m => ({ id: m.id, title: m.title, done: passedSet.has(m.id), unlocked: moduleUnlocked(m.id, passedSet) })) }));
  return { disciplines, modulesDone: c.modules.filter(m => passedSet.has(m.id)).length, modulesTotal: c.modules.length, finished: c.modules.every(m => passedSet.has(m.id)) };
}
// Escolhe as questões do vestibular (ids) com um sorteio injetável (para teste).
function pickExam(rnd = Math.random, n = UNI.VEST_QUESTIONS) {
  const ids = VEST_BANK.map(q => q.id);
  for (let i = ids.length - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [ids[i], ids[j]] = [ids[j], ids[i]]; }
  return ids.slice(0, n);
}
const approvedCourses = best => Object.values(COURSES).filter(c => Number(best) >= c.cutoff).map(c => c.id);
function livePay(attendees, paidToday) {
  const n = Math.min(Math.max(0, attendees | 0), UNI.LIVE_PAY_MAX);
  return paidToday >= UNI.LIVE_DAILY_PAID || n < 1 ? 0 : n * UNI.LIVE_PAY;
}
const publicQuestion = q => ({ id: q.id, q: q.q, options: q.options, subject: q.subject });

/* ---------- banco de dados ---------- */
async function init() {
  await db.query(`CREATE TABLE IF NOT EXISTS sk2_uni_passes (
    username TEXT PRIMARY KEY REFERENCES sk2_players(username) ON DELETE CASCADE, role TEXT NOT NULL CHECK (role IN ('aluno','professor','visitante')),
    purpose TEXT, code TEXT NOT NULL, issued_at TIMESTAMPTZ NOT NULL DEFAULT now(), expires_at TIMESTAMPTZ NOT NULL);
  CREATE TABLE IF NOT EXISTS sk2_uni_vest (username TEXT PRIMARY KEY REFERENCES sk2_players(username) ON DELETE CASCADE, best INT NOT NULL DEFAULT 0, updated_at TIMESTAMPTZ NOT NULL DEFAULT now());
  CREATE TABLE IF NOT EXISTS sk2_uni_exams (
    id UUID PRIMARY KEY, username TEXT NOT NULL REFERENCES sk2_players(username) ON DELETE CASCADE, qids TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'aberta' CHECK (status IN ('aberta','concluida','expirada')), score INT, started_at TIMESTAMPTZ NOT NULL DEFAULT now(), expires_at TIMESTAMPTZ NOT NULL);
  CREATE INDEX IF NOT EXISTS sk2_uni_exams_user ON sk2_uni_exams(username, started_at);
  CREATE TABLE IF NOT EXISTS sk2_uni_students (
    username TEXT PRIMARY KEY REFERENCES sk2_players(username) ON DELETE CASCADE, course TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'ativo' CHECK (status IN ('ativo','formado')), credits INT NOT NULL DEFAULT 0, enrolled_at TIMESTAMPTZ NOT NULL DEFAULT now());
  CREATE TABLE IF NOT EXISTS sk2_uni_progress (
    username TEXT NOT NULL REFERENCES sk2_players(username) ON DELETE CASCADE, module_id TEXT NOT NULL, started_at TIMESTAMPTZ, attempt_at TIMESTAMPTZ,
    passed BOOLEAN NOT NULL DEFAULT false, best INT NOT NULL DEFAULT 0, PRIMARY KEY (username, module_id));
  CREATE TABLE IF NOT EXISTS sk2_uni_diplomas (
    username TEXT NOT NULL REFERENCES sk2_players(username) ON DELETE CASCADE, course TEXT NOT NULL, at TIMESTAMPTZ NOT NULL DEFAULT now(), PRIMARY KEY (username, course));
  CREATE TABLE IF NOT EXISTS sk2_uni_live (
    id UUID PRIMARY KEY, professor TEXT NOT NULL REFERENCES sk2_players(username) ON DELETE CASCADE, professor_name TEXT NOT NULL, module_id TEXT NOT NULL, course TEXT NOT NULL,
    opened_at TIMESTAMPTZ NOT NULL DEFAULT now(), ends_at TIMESTAMPTZ NOT NULL, closed_at TIMESTAMPTZ, paid INT NOT NULL DEFAULT 0);
  CREATE INDEX IF NOT EXISTS sk2_uni_live_open ON sk2_uni_live(course, ends_at);
  CREATE TABLE IF NOT EXISTS sk2_uni_live_att (live_id UUID NOT NULL REFERENCES sk2_uni_live(id) ON DELETE CASCADE, username TEXT NOT NULL REFERENCES sk2_players(username) ON DELETE CASCADE, PRIMARY KEY (live_id, username));
  CREATE TABLE IF NOT EXISTS sk2_uni_meta (username TEXT PRIMARY KEY REFERENCES sk2_players(username) ON DELETE CASCADE, canteen_at TIMESTAMPTZ);`);
}
const fail = (err, status = 409) => ({ err, status });
const epoch = d => (d ? new Date(d).getTime() : null);
const ago = ms => `now() - (${Math.max(1, Math.round(ms))}::bigint * interval '1 millisecond')`;
const secondsLeft = ms => Math.ceil(ms / 1000);

async function loadContext(c, row) {
  const passRow = (await c.query('SELECT role, purpose, code, issued_at, expires_at FROM sk2_uni_passes WHERE username = $1', [row.username])).rows[0];
  const pass = passRow ? { role: passRow.role, purpose: passRow.purpose, code: passRow.code, issuedAt: epoch(passRow.issued_at), expiresAt: epoch(passRow.expires_at) } : null;
  const st = (await c.query('SELECT course, status, credits, enrolled_at FROM sk2_uni_students WHERE username = $1', [row.username])).rows[0];
  const student = st ? { course: st.course, status: st.status, credits: st.credits, enrolledAt: epoch(st.enrolled_at) } : null;
  const now = Date.now();
  return { pass, student, now, access: buildAccess(pass, student, now), role: pass && passValid(pass, now) ? pass.role : null };
}
const allowed = (ctx, zone) => ctx.access[zone] && ctx.access[zone].ok;
const denyZone = (ctx, zone) => fail(ctx.access[zone] ? ctx.access[zone].why : 'Acesso negado.', 403);

async function snapshot(c, row, ctx) {
  const u = row.username, now = Date.now();
  const passed = new Set((await c.query('SELECT module_id FROM sk2_uni_progress WHERE username = $1 AND passed', [u])).rows.map(r => r.module_id));
  const diplomas = (await c.query('SELECT course, at FROM sk2_uni_diplomas WHERE username = $1 ORDER BY at', [u])).rows.map(d => ({ course: d.course, name: COURSES[d.course]?.name || d.course, at: epoch(d.at) }));
  const vest = (await c.query('SELECT best FROM sk2_uni_vest WHERE username = $1', [u])).rows[0];
  const exams = (await c.query(`SELECT id, status, started_at, expires_at FROM sk2_uni_exams WHERE username = $1 AND started_at > ${ago(hoursMs(24))} ORDER BY started_at DESC`, [u])).rows;
  const open = exams.find(e => e.status === 'aberta' && epoch(e.expires_at) > now);
  const cool = exams[0] ? epoch(exams[0].started_at) + minutesMs(UNI.VEST_COOLDOWN_MIN) : 0;
  const meta = (await c.query('SELECT canteen_at FROM sk2_uni_meta WHERE username = $1', [u])).rows[0];
  const canteenAt = meta && meta.canteen_at ? epoch(meta.canteen_at) + secondsMs(UNI.CANTEEN_COOLDOWN_S) : 0;
  const best = vest ? vest.best : 0;
  const eligible = ['visitante'];
  if (ctx.student && ctx.student.status === 'ativo') eligible.push('aluno');
  if (row.employment && row.employment.jobId === UNI.PROFESSOR_JOB) eligible.push('professor');
  const out = {
    serverNow: now,
    me: { username: u, name: row.name, money: Number(row.money) || 0, xp: Number(row.xp) || 0, eligible, role: ctx.role },
    pass: ctx.pass ? { ...ctx.pass, valid: passValid(ctx.pass, now), courseName: ctx.student && ctx.student.course ? COURSES[ctx.student.course]?.name : null } : null,
    access: Object.fromEntries(Object.entries(ctx.access).map(([z, a]) => [z, { ok: a.ok, why: a.why }])),
    student: ctx.student ? { ...ctx.student, name: COURSES[ctx.student.course]?.name, ...courseStatus(ctx.student.course, passed) } : null,
    diplomas,
    vest: { best, approved: approvedCourses(best), attemptsToday: exams.length, attemptsMax: UNI.VEST_ATTEMPTS_DAY, nextAt: cool > now && exams.length ? cool : 0, activeId: open ? open.id : null, activeUntil: open ? epoch(open.expires_at) : 0 },
    courses: Object.values(COURSES).map(cs => ({ id: cs.id, name: cs.name, icon: cs.icon, cutoff: cs.cutoff, labs: cs.labs, disciplines: cs.disciplines.map(d => ({ id: d.id, name: d.name, modules: d.modules.map(m => ({ id: m.id, title: m.title })) })) })),
    canteen: { menu: CANTEEN.map(i => ({ id: i.id, name: i.name, icon: i.icon, heal: i.heal, price: i.price, pay: ctx.role ? canteenPrice(i.id, ctx.role) : i.price })), discount: ctx.role ? DISCOUNT[ctx.role] : 0, waitUntil: canteenAt > now ? canteenAt : 0 },
    constants: { ...UNI, purposes: Object.fromEntries(Object.entries(VISIT_PURPOSES).map(([k, v]) => [k, { label: v.label, zones: v.zones }])), zones: ZONES },
    live: [], myLive: null,
  };
  if (ctx.student && ctx.student.status === 'ativo') {
    out.live = (await c.query(`SELECT l.id, l.professor_name, l.module_id, l.ends_at, EXISTS (SELECT 1 FROM sk2_uni_live_att a WHERE a.live_id = l.id AND a.username = $2) AS joined
      FROM sk2_uni_live l WHERE l.course = $1 AND l.closed_at IS NULL AND l.ends_at > now() ORDER BY l.opened_at DESC LIMIT 5`, [ctx.student.course, u])).rows
      .map(l => ({ id: l.id, professor: l.professor_name, module: l.module_id, title: MODULE_BY_ID[l.module_id]?.title || l.module_id, endsAt: epoch(l.ends_at), joined: l.joined }));
  }
  if (eligible.includes('professor')) {
    const l = (await c.query(`SELECT l.id, l.module_id, l.ends_at, l.closed_at, l.paid, (SELECT COUNT(*) FROM sk2_uni_live_att a WHERE a.live_id = l.id)::int AS n
      FROM sk2_uni_live l WHERE l.professor = $1 AND l.closed_at IS NULL ORDER BY l.opened_at DESC LIMIT 1`, [u])).rows[0];
    out.myLive = l ? { id: l.id, module: l.module_id, title: MODULE_BY_ID[l.module_id]?.title || l.module_id, endsAt: epoch(l.ends_at), attendees: l.n, running: epoch(l.ends_at) > now } : null;
    const paidToday = Number((await c.query(`SELECT COUNT(*) AS n FROM sk2_uni_live WHERE professor = $1 AND paid > 0 AND closed_at > ${ago(hoursMs(24))}`, [u])).rows[0].n);
    out.professor = { paidToday, paidMax: UNI.LIVE_DAILY_PAID };
  }
  return out;
}
const run = (username, fn) => db.withTx(async c => {
  const locked = (await c.query('SELECT * FROM sk2_players WHERE username = $1 FOR UPDATE', [username])).rows[0];
  if (!locked) return fail('Jogador não encontrado', 404);
  const ctx = await loadContext(c, locked);
  const out = await fn(c, locked, ctx);
  if (out.err) return out;
  const player = out.player || locked, ctx2 = out.reload ? await loadContext(c, player) : ctx;
  return { ...out, playerRow: player, university: await snapshot(c, player, ctx2) };
});
const summary = username => run(username, (_c, p) => ({ player: p }));
const newCode = () => 'UN-' + crypto.randomBytes(3).toString('hex').toUpperCase();

/* ---------- operações ---------- */
const issuePass = (username, input) => run(username, async (c, p, ctx) => {
  const role = input?.role;
  if (!['aluno', 'professor', 'visitante'].includes(role)) return fail('Escolha o tipo de carteirinha.', 400);
  let purpose = null;
  if (role === 'visitante') {
    purpose = input?.purpose;
    if (!hasOwn(VISIT_PURPOSES, purpose)) return fail('Informe o motivo da visita.', 400);
  } else if (role === 'aluno') {
    if (!(ctx.student && ctx.student.status === 'ativo')) return fail('Só alunos com matrícula ativa recebem a carteirinha de aluno. Faça o vestibular e se matricule.', 403);
  } else if (!(p.employment && p.employment.jobId === UNI.PROFESSOR_JOB)) return fail('Só professores contratados recebem a carteirinha de professor.', 403);
  const code = newCode(), ms = hoursMs(UNI.PASS_HOURS[role]);
  await c.query(`INSERT INTO sk2_uni_passes (username, role, purpose, code, issued_at, expires_at) VALUES ($1,$2,$3,$4, now(), now() + ($5::bigint * interval '1 millisecond'))
    ON CONFLICT (username) DO UPDATE SET role = EXCLUDED.role, purpose = EXCLUDED.purpose, code = EXCLUDED.code, issued_at = now(), expires_at = EXCLUDED.expires_at`, [username, role, purpose, code, ms]);
  const label = role === 'visitante' ? `visitante (${VISIT_PURPOSES[purpose].label.toLowerCase()})` : role;
  return { player: p, reload: true, event: { kind: 'pass', role }, message: `Carteirinha de ${label} emitida: ${code}. Passe pelas catracas e mantenha-a à vista.` };
});
const returnPass = username => run(username, async (c, p, ctx) => {
  if (!ctx.pass) return fail('Você não está com carteirinha.');
  await c.query('DELETE FROM sk2_uni_passes WHERE username = $1', [username]);
  return { player: p, reload: true, event: { kind: 'return' }, message: 'Carteirinha devolvida. Volte sempre!' };
});

const vestStart = username => run(username, async (c, p, ctx) => {
  if (!(ctx.role === 'visitante' && ctx.pass.purpose === 'vestibular')) return fail('O vestibular é para visitantes com carteirinha de motivo "vestibular".', 403);
  if (!allowed(ctx, 'provas')) return denyZone(ctx, 'provas');
  const now = Date.now();
  const open = (await c.query(`SELECT id, qids, expires_at FROM sk2_uni_exams WHERE username = $1 AND status = 'aberta' AND expires_at > now() ORDER BY started_at DESC LIMIT 1 FOR UPDATE`, [username])).rows[0];
  const mk = (id, qids, until) => ({ id, until, questions: qids.split(',').map(i => publicQuestion(VEST_BY_ID[i])) });
  if (open) return { player: p, data: { exam: mk(open.id, open.qids, epoch(open.expires_at)) }, message: 'Sua prova em andamento foi retomada.' };
  const recent = (await c.query(`SELECT started_at FROM sk2_uni_exams WHERE username = $1 AND started_at > ${ago(hoursMs(24))} ORDER BY started_at DESC`, [username])).rows;
  if (recent.length >= UNI.VEST_ATTEMPTS_DAY) return fail(`Limite de ${UNI.VEST_ATTEMPTS_DAY} provas por dia atingido.`);
  if (recent[0] && epoch(recent[0].started_at) + minutesMs(UNI.VEST_COOLDOWN_MIN) > now) return fail(`Aguarde ${secondsLeft(epoch(recent[0].started_at) + minutesMs(UNI.VEST_COOLDOWN_MIN) - now)} s para tentar de novo.`);
  if (Number(p.money) < UNI.VEST_FEE) return fail(`Saldo insuficiente: a taxa do vestibular é ${brl(UNI.VEST_FEE)}.`);
  const player = (await c.query('UPDATE sk2_players SET money = money - $2 WHERE username = $1 RETURNING *', [username, UNI.VEST_FEE])).rows[0];
  await city.credit(c, 'universidade', UNI.VEST_FEE, `Taxa de vestibular de ${p.name}`);
  const qids = pickExam(() => crypto.randomInt(0, 1e9) / 1e9).join(','), id = crypto.randomUUID();
  await c.query(`INSERT INTO sk2_uni_exams (id, username, qids, expires_at) VALUES ($1,$2,$3, now() + ($4::bigint * interval '1 millisecond'))`, [id, username, qids, minutesMs(UNI.VEST_MINUTES)]);
  return { player, event: { kind: 'exam' }, data: { exam: mk(id, qids, now + minutesMs(UNI.VEST_MINUTES)) }, message: `Taxa de ${brl(UNI.VEST_FEE)} paga. Boa prova! Você tem ${UNI.VEST_MINUTES} minutos.` };
});
const vestSubmit = (username, id, answers) => run(username, async (c, p, ctx) => {
  if (!UUID.test(String(id))) return fail('Prova inválida.', 400);
  const ex = (await c.query(`SELECT id, qids, status, expires_at FROM sk2_uni_exams WHERE id = $1 AND username = $2 FOR UPDATE`, [id, username])).rows[0];
  if (!ex || ex.status !== 'aberta') return fail('Esta prova não está em andamento.', 404);
  if (epoch(ex.expires_at) < Date.now()) { await c.query(`UPDATE sk2_uni_exams SET status = 'expirada' WHERE id = $1`, [id]); return fail('O tempo da prova acabou.'); }
  const qs = ex.qids.split(',').map(i => VEST_BY_ID[i]), g = grade(qs, answers);
  if (g.err) return fail(g.err, 400);
  await c.query(`UPDATE sk2_uni_exams SET status = 'concluida', score = $2 WHERE id = $1`, [id, g.correct]);
  await c.query(`INSERT INTO sk2_uni_vest (username, best) VALUES ($1,$2) ON CONFLICT (username) DO UPDATE SET best = GREATEST(sk2_uni_vest.best, EXCLUDED.best), updated_at = now()`, [username, g.correct]);
  const best = Number((await c.query('SELECT best FROM sk2_uni_vest WHERE username = $1', [username])).rows[0].best), ok = approvedCourses(g.correct);
  return { player: p, event: { kind: 'examDone', score: g.correct }, data: { result: { score: g.correct, total: g.total, review: g.review, best, approved: ok.map(k => COURSES[k].name) } },
    message: ok.length ? `Nota ${g.correct}/${g.total}: aprovado em ${ok.map(k => COURSES[k].name).join(', ')}. Matricule-se na Secretaria.` : `Nota ${g.correct}/${g.total}: não alcançou a nota de corte de nenhum curso. Estude e tente de novo.` };
});

const enroll = (username, course) => run(username, async (c, p, ctx) => {
  if (!hasOwn(COURSES, course)) return fail('Curso inválido.', 400);
  if (!allowed(ctx, 'secretaria')) return denyZone(ctx, 'secretaria');
  if (ctx.student && ctx.student.status === 'ativo') return fail('Você já tem uma matrícula ativa. Conclua o curso antes de se matricular em outro.');
  const best = Number((await c.query('SELECT best FROM sk2_uni_vest WHERE username = $1', [username])).rows[0]?.best || 0);
  if (best < COURSES[course].cutoff) return fail(`Nota de corte de ${COURSES[course].name}: ${COURSES[course].cutoff}. Sua melhor nota é ${best}.`);
  if (Number(p.money) < UNI.ENROLL_FEE) return fail(`Saldo insuficiente: a matrícula custa ${brl(UNI.ENROLL_FEE)}.`);
  const dip = (await c.query('SELECT 1 FROM sk2_uni_diplomas WHERE username = $1 AND course = $2', [username, course])).rowCount;
  if (dip) return fail(`Você já é formado em ${COURSES[course].name}.`);
  const player = (await c.query('UPDATE sk2_players SET money = money - $2 WHERE username = $1 RETURNING *', [username, UNI.ENROLL_FEE])).rows[0];
  await city.credit(c, 'universidade', UNI.ENROLL_FEE, `Matrícula de ${p.name} em ${COURSES[course].name}`);
  await c.query(`INSERT INTO sk2_uni_students (username, course, status, credits, enrolled_at) VALUES ($1,$2,'ativo',0, now())
    ON CONFLICT (username) DO UPDATE SET course = EXCLUDED.course, status = 'ativo', credits = 0, enrolled_at = now()`, [username, course]);
  return { player, reload: true, event: { kind: 'enroll' }, message: `Matrícula em ${COURSES[course].name} confirmada! Retire a carteirinha de aluno na recepção.` };
});

async function passedModules(c, username) { return new Set((await c.query('SELECT module_id FROM sk2_uni_progress WHERE username = $1 AND passed', [username])).rows.map(r => r.module_id)); }
function needStudent(ctx, mod) {
  if (ctx.role !== 'aluno') return fail('As aulas são para alunos com carteirinha de aluno válida.', 403);
  if (!allowed(ctx, 'salas')) return denyZone(ctx, 'salas');
  if (!mod) return fail('Aula inválida.', 400);
  if (!(ctx.student && ctx.student.status === 'ativo' && ctx.student.course === mod.course)) return fail('Esta aula não é do seu curso.', 403);
  return null;
}
const lessonStart = (username, moduleId) => run(username, async (c, p, ctx) => {
  const mod = hasOwn(MODULE_BY_ID, moduleId) ? MODULE_BY_ID[moduleId] : null, bad = needStudent(ctx, mod); if (bad) return bad;
  if (!moduleUnlocked(moduleId, await passedModules(c, username))) return fail('Conclua a aula anterior antes desta.');
  // quem está numa aula ao vivo desse módulo já cumpriu o tempo de estudo
  const live = (await c.query(`SELECT 1 FROM sk2_uni_live l JOIN sk2_uni_live_att a ON a.live_id = l.id WHERE a.username = $1 AND l.module_id = $2 AND l.closed_at IS NULL AND l.ends_at > now()`, [username, moduleId])).rowCount > 0;
  const study = secondsMs(UNI.STUDY_SECONDS);
  await c.query(`INSERT INTO sk2_uni_progress (username, module_id, started_at) VALUES ($1,$2, now() - ($3::bigint * interval '1 millisecond')) ON CONFLICT (username, module_id) DO UPDATE SET started_at = EXCLUDED.started_at`, [username, moduleId, live ? study + 1000 : 0]);
  return { player: p, event: { kind: 'lesson' }, data: { lesson: { id: mod.id, title: mod.title, text: mod.text, studyMs: study, until: live ? Date.now() : Date.now() + study, live, questions: mod.quiz.map(q => ({ id: q.id, q: q.q, options: q.options })) } },
    message: live ? 'Aula ao vivo: o tempo de estudo foi dispensado. Faça a prova quando quiser.' : `Aula iniciada: leia com atenção. A prova libera em ${UNI.STUDY_SECONDS} s.` };
});
const lessonSubmit = (username, moduleId, answers) => run(username, async (c, p, ctx) => {
  const mod = hasOwn(MODULE_BY_ID, moduleId) ? MODULE_BY_ID[moduleId] : null, bad = needStudent(ctx, mod); if (bad) return bad;
  const row = (await c.query('SELECT started_at, attempt_at, passed FROM sk2_uni_progress WHERE username = $1 AND module_id = $2 FOR UPDATE', [username, moduleId])).rows[0];
  if (!row || !row.started_at) return fail('Comece a aula antes de fazer a prova.');
  const now = Date.now();
  if (epoch(row.started_at) + secondsMs(UNI.STUDY_SECONDS) > now) return fail(`Leia a aula com calma: a prova libera em ${secondsLeft(epoch(row.started_at) + secondsMs(UNI.STUDY_SECONDS) - now)} s.`);
  if (row.attempt_at && epoch(row.attempt_at) + secondsMs(UNI.QUIZ_COOLDOWN_S) > now) return fail(`Aguarde ${secondsLeft(epoch(row.attempt_at) + secondsMs(UNI.QUIZ_COOLDOWN_S) - now)} s para tentar de novo.`);
  const g = grade(mod.quiz, answers); if (g.err) return fail(g.err, 400);
  const ok = quizPassed(g.correct);
  await c.query('UPDATE sk2_uni_progress SET attempt_at = now(), best = GREATEST(best, $3), passed = passed OR $4 WHERE username = $1 AND module_id = $2', [username, moduleId, g.correct, ok]);
  const reward = { xp: 0, money: 0, discipline: null, diploma: null };
  let player = p, reload = false;
  if (ok && !row.passed) {
    reward.xp += UNI.MODULE_XP;
    const passed = await passedModules(c, username), cs = courseStatus(mod.course, passed);
    const disc = cs.disciplines.find(d => d.id === mod.discipline);
    if (disc && disc.done) { reward.xp += UNI.DISCIPLINE_XP; reward.discipline = disc.name; await c.query('UPDATE sk2_uni_students SET credits = credits + $2 WHERE username = $1', [username, UNI.DISCIPLINE_CREDITS]); }
    if (cs.finished) {
      reward.xp += UNI.DIPLOMA_XP; reward.diploma = COURSES[mod.course].name; reload = true;
      await c.query(`INSERT INTO sk2_uni_diplomas (username, course) VALUES ($1,$2) ON CONFLICT DO NOTHING`, [username, mod.course]);
      await c.query(`UPDATE sk2_uni_students SET status = 'formado' WHERE username = $1`, [username]);
      const paid = await city.debit(c, 'universidade', UNI.DIPLOMA_REWARD, `Bolsa de formatura de ${p.name}`);
      if (paid !== null) reward.money = UNI.DIPLOMA_REWARD;
    }
    player = (await c.query('UPDATE sk2_players SET xp = xp + $2, money = money + $3 WHERE username = $1 RETURNING *', [username, reward.xp, reward.money])).rows[0];
  }
  const review = g.review.map((r, i) => ({ ok: r, why: ok && r ? mod.quiz[i].why : '' }));
  const msg = !ok ? `Você acertou ${g.correct} de ${g.total}. Releia a aula e tente de novo.`
    : row.passed ? `Aprovado de novo (${g.correct}/${g.total}). Sem recompensa repetida.`
      : `Aprovado (${g.correct}/${g.total})! +${reward.xp} XP${reward.discipline ? ` · disciplina concluída: ${reward.discipline}` : ''}${reward.diploma ? ` · DIPLOMA em ${reward.diploma}${reward.money ? ` e bolsa de ${brl(reward.money)}` : ''}` : ''}.`;
  return { player, reload, event: { kind: ok ? 'quizOk' : 'quizFail', diploma: !!reward.diploma }, data: { result: { passed: ok, correct: g.correct, total: g.total, review, reward, repeat: !!row.passed } }, message: msg };
});

const liveOpen = (username, moduleId) => run(username, async (c, p, ctx) => {
  if (ctx.role !== 'professor') return fail('Só professores com carteirinha válida abrem aula ao vivo.', 403);
  if (!allowed(ctx, 'salas')) return denyZone(ctx, 'salas');
  const mod = hasOwn(MODULE_BY_ID, moduleId) ? MODULE_BY_ID[moduleId] : null; if (!mod) return fail('Aula inválida.', 400);
  if ((await c.query('SELECT 1 FROM sk2_uni_live WHERE professor = $1 AND closed_at IS NULL', [username])).rowCount) return fail('Você já tem uma aula aberta. Encerre-a primeiro.');
  const id = crypto.randomUUID();
  await c.query(`INSERT INTO sk2_uni_live (id, professor, professor_name, module_id, course, ends_at) VALUES ($1,$2,$3,$4,$5, now() + ($6::bigint * interval '1 millisecond'))`, [id, username, p.name, mod.id, mod.course, minutesMs(UNI.LIVE_MINUTES)]);
  return { player: p, event: { kind: 'liveOpen' }, message: `Aula ao vivo aberta: ${mod.title}. Ela dura ${UNI.LIVE_MINUTES} minutos.` };
});
const liveJoin = (username, id) => run(username, async (c, p, ctx) => {
  if (!UUID.test(String(id))) return fail('Aula inválida.', 400);
  const live = (await c.query('SELECT id, module_id, course, ends_at, closed_at FROM sk2_uni_live WHERE id = $1 FOR UPDATE', [id])).rows[0];
  if (!live || live.closed_at || epoch(live.ends_at) < Date.now()) return fail('Esta aula ao vivo já terminou.', 404);
  const bad = needStudent(ctx, MODULE_BY_ID[live.module_id]); if (bad) return bad;
  if (!moduleUnlocked(live.module_id, await passedModules(c, username))) return fail('Conclua a aula anterior antes de entrar nesta.');
  const ins = await c.query('INSERT INTO sk2_uni_live_att (live_id, username) VALUES ($1,$2) ON CONFLICT DO NOTHING', [id, username]);
  await c.query(`INSERT INTO sk2_uni_progress (username, module_id, started_at) VALUES ($1,$2, now() - ($3::bigint * interval '1 millisecond')) ON CONFLICT (username, module_id) DO UPDATE SET started_at = EXCLUDED.started_at`, [username, live.module_id, secondsMs(UNI.STUDY_SECONDS) + 1000]);
  let player = p;
  if (ins.rowCount) player = (await c.query('UPDATE sk2_players SET xp = xp + $2 WHERE username = $1 RETURNING *', [username, UNI.LIVE_JOIN_XP])).rows[0];
  return { player, event: { kind: 'liveJoin' }, data: { open: live.module_id }, message: ins.rowCount ? `Você entrou na aula ao vivo (+${UNI.LIVE_JOIN_XP} XP). O tempo de estudo foi dispensado: faça a prova.` : 'Você já está nesta aula ao vivo.' };
});
const liveClose = (username, id) => run(username, async (c, p, ctx) => {
  if (!UUID.test(String(id))) return fail('Aula inválida.', 400);
  if (ctx.role !== 'professor') return fail('Só professores com carteirinha válida encerram aulas.', 403);
  const live = (await c.query('SELECT id, professor, ends_at, closed_at FROM sk2_uni_live WHERE id = $1 AND professor = $2 FOR UPDATE', [id, username])).rows[0];
  if (!live || live.closed_at) return fail('Esta aula já foi encerrada.', 404);
  const left = epoch(live.ends_at) - Date.now(); if (left > 0) return fail(`A aula ainda está em andamento (${secondsLeft(left)} s).`);
  const n = Number((await c.query('SELECT COUNT(*) AS n FROM sk2_uni_live_att WHERE live_id = $1', [id])).rows[0].n);
  const paidToday = Number((await c.query(`SELECT COUNT(*) AS n FROM sk2_uni_live WHERE professor = $1 AND paid > 0 AND closed_at > ${ago(hoursMs(24))}`, [username])).rows[0].n);
  let pay = livePay(n, paidToday), note = '';
  if (pay > 0) { const ok = await city.debit(c, 'universidade', pay, `Aula ao vivo de ${p.name} (${Math.min(n, UNI.LIVE_PAY_MAX)} alunos)`); if (ok === null) { pay = 0; note = ' O tesouro está sem saldo para o pagamento.'; } }
  else if (n > 0) note = ` Limite diário de ${UNI.LIVE_DAILY_PAID} aulas pagas atingido.`;
  else note = ' Nenhum aluno compareceu.';
  const player = (await c.query('UPDATE sk2_players SET money = money + $2, xp = xp + $3 WHERE username = $1 RETURNING *', [username, pay, n > 0 ? UNI.LIVE_HOST_XP : 0])).rows[0];
  await c.query('UPDATE sk2_uni_live SET closed_at = now(), paid = $2 WHERE id = $1', [id, pay]);
  return { player, event: { kind: 'liveClose', pay }, message: `Aula encerrada com ${n} aluno(s).${pay ? ` Pagamento: ${brl(pay)}.` : ''}${note}` };
});

const canteenBuy = (username, itemId) => run(username, async (c, p, ctx) => {
  if (!hasOwn(CANTEEN_BY_ID, itemId)) return fail('Item inválido.', 400);
  if (!allowed(ctx, 'cantina')) return denyZone(ctx, 'cantina');
  const meta = (await c.query('SELECT canteen_at FROM sk2_uni_meta WHERE username = $1 FOR UPDATE', [username])).rows[0];
  const wait = meta && meta.canteen_at ? epoch(meta.canteen_at) + secondsMs(UNI.CANTEEN_COOLDOWN_S) - Date.now() : 0;
  if (wait > 0) return fail(`Mastigue com calma: aguarde ${secondsLeft(wait)} s para pedir de novo.`);
  const price = canteenPrice(itemId, ctx.role), it = CANTEEN_BY_ID[itemId];
  if (Number(p.money) < price) return fail(`Saldo insuficiente: ${it.name} custa ${brl(price)}.`);
  const st = await hospital.settle(c, p);
  if (st.health >= 100) return fail('Sua saúde já está no máximo: guarde o dinheiro.');
  const gain = Math.min(it.heal, 100 - st.health);
  const player = (await c.query('UPDATE sk2_players SET money = money - $2 WHERE username = $1 RETURNING *', [username, price])).rows[0];
  await city.credit(c, 'universidade', price, `Cantina universitária: ${it.name}`);
  await c.query('UPDATE sk2_hospital_patients SET health = $2, health_at = now() WHERE username = $1', [username, st.health + gain]);
  await c.query('INSERT INTO sk2_uni_meta (username, canteen_at) VALUES ($1, now()) ON CONFLICT (username) DO UPDATE SET canteen_at = now()', [username]);
  return { player, event: { kind: 'canteen', item: itemId }, message: `${it.name}: ${brl(price)}${DISCOUNT[ctx.role] ? ` (desconto de ${DISCOUNT[ctx.role]}%)` : ''} · +${gain} de saúde (agora ${st.health + gain}%).` };
});

/* ---------- rotas ---------- */
function registerRoutes({ app, json, authUser, limited, userTries }) {
  const guard = fn => async (req, res) => {
    try {
      const row = await authUser(req);
      if (!row) return res.status(401).json({ err: 'Sessão expirada' });
      if (limited(userTries, `uni:${row.username}`, 60)) return res.status(429).json({ err: 'Muitas ações na Universidade. Aguarde um minuto.' });
      await fn(req, res, row);
    } catch (e) {
      console.error('[sk2] universidade:', e.message);
      if (!res.headersSent) res.status(500).json({ err: 'Não foi possível concluir a operação na Universidade.' });
    }
  };
  const done = (res, r) => {
    if (r.err) return res.status(r.status || 409).json({ err: r.err });
    res.json({ ok: 1, player: db.pub(r.playerRow), university: r.university, data: r.data || null, event: r.event || null, message: r.message || '' });
  };
  const bad = (res, m) => res.status(400).json({ err: m });
  app.get('/api/sk2/university', guard(async (_q, res, row) => { res.set('Cache-Control', 'no-store'); done(res, await summary(row.username)); }));
  app.post('/api/sk2/university/pass', json, guard(async (req, res, row) => {
    if (typeof req.body?.role !== 'string') return bad(res, 'Escolha o tipo de carteirinha.');
    done(res, await issuePass(row.username, { role: req.body.role, purpose: typeof req.body.purpose === 'string' ? req.body.purpose : undefined }));
  }));
  app.post('/api/sk2/university/pass/return', json, guard(async (_q, res, row) => done(res, await returnPass(row.username))));
  app.post('/api/sk2/university/vest/start', json, guard(async (_q, res, row) => done(res, await vestStart(row.username))));
  app.post('/api/sk2/university/vest/submit', json, guard(async (req, res, row) => {
    if (typeof req.body?.id !== 'string' || !Array.isArray(req.body?.answers)) return bad(res, 'Envie a prova e as respostas.');
    done(res, await vestSubmit(row.username, req.body.id, req.body.answers));
  }));
  app.post('/api/sk2/university/enroll', json, guard(async (req, res, row) => {
    if (typeof req.body?.course !== 'string') return bad(res, 'Escolha o curso.');
    done(res, await enroll(row.username, req.body.course));
  }));
  app.post('/api/sk2/university/lesson/start', json, guard(async (req, res, row) => {
    if (typeof req.body?.module !== 'string') return bad(res, 'Escolha a aula.');
    done(res, await lessonStart(row.username, req.body.module));
  }));
  app.post('/api/sk2/university/lesson/submit', json, guard(async (req, res, row) => {
    if (typeof req.body?.module !== 'string' || !Array.isArray(req.body?.answers)) return bad(res, 'Envie a aula e as respostas.');
    done(res, await lessonSubmit(row.username, req.body.module, req.body.answers));
  }));
  app.post('/api/sk2/university/live/open', json, guard(async (req, res, row) => {
    if (typeof req.body?.module !== 'string') return bad(res, 'Escolha a aula.');
    done(res, await liveOpen(row.username, req.body.module));
  }));
  app.post('/api/sk2/university/live/join', json, guard(async (req, res, row) => done(res, await liveJoin(row.username, req.body?.id))));
  app.post('/api/sk2/university/live/close', json, guard(async (req, res, row) => done(res, await liveClose(row.username, req.body?.id))));
  app.post('/api/sk2/university/canteen', json, guard(async (req, res, row) => {
    if (typeof req.body?.item !== 'string') return bad(res, 'Escolha o item.');
    done(res, await canteenBuy(row.username, req.body.item));
  }));
}

