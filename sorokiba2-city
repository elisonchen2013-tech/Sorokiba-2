// Usadas por Banco e Hospital, dentro da transação deles (jogadores primeiro, tesouro depois: evita deadlock).
async function credit(c, kind, amount, note) {
  if (!(amount > 0)) return null;
  const r = await c.query('UPDATE sk2_city_treasury SET balance = balance + $1 WHERE id = 1 RETURNING balance', [amount]);
  await c.query('INSERT INTO sk2_city_ledger (kind, amount, balance_after, note) VALUES ($1,$2,$3,$4)', [kind, amount, r.rows[0].balance, note || null]);
  return Number(r.rows[0].balance);
}
async function debit(c, kind, amount, note) {
  const cur = (await c.query('SELECT balance FROM sk2_city_treasury WHERE id = 1 FOR UPDATE')).rows[0];
  if (!cur || Number(cur.balance) < amount) return null;
  const r = await c.query('UPDATE sk2_city_treasury SET balance = balance - $1 WHERE id = 1 RETURNING balance', [amount]);
  await c.query('INSERT INTO sk2_city_ledger (kind, amount, balance_after, note) VALUES ($1,$2,$3,$4)', [kind, -amount, r.rows[0].balance, note || null]);
  return Number(r.rows[0].balance);
}
async function policy(c, key) {
  const r = await c.query('SELECT value FROM sk2_city_policy WHERE key = $1', [key]);
  return r.rowCount ? r.rows[0].value : POLICIES[key].def;
}
async function policies(c) {
  const r = await c.query('SELECT key, value FROM sk2_city_policy');
  const out = Object.fromEntries(Object.entries(POLICIES).map(([k, p]) => [k, p.def]));
  for (const row of r.rows) if (out[row.key] !== undefined) out[row.key] = row.value;
  return out;
}
async function applyPolicy(c, key, value, by) {
  await c.query(`INSERT INTO sk2_city_policy (key, value, updated_by) VALUES ($1,$2,$3)
    ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, updated_by = EXCLUDED.updated_by, updated_at = now()`, [key, value, by]);
  if (key === 'health_subsidy_max') await c.query(`UPDATE sk2_city_policy SET value = LEAST(value, $1) WHERE key = 'health_subsidy_pct'`, [value]);
}

async function sample(c) {
  const online = Math.max(0, Number(onlineProvider()) || 0);
  const r = (await c.query(`SELECT
    (SELECT COUNT(*) FROM sk2_players)::int AS pop,
    (SELECT COALESCE(SUM(money), 0) FROM sk2_players)::bigint AS money,
    (SELECT COALESCE(SUM(savings), 0) FROM sk2_bank_accounts)::bigint AS savings,
    (SELECT COALESCE(SUM(total_due - paid), 0) FROM sk2_bank_loans WHERE status = 'active')::bigint AS loans,
    (SELECT COUNT(*) FROM sk2_hospital_conditions WHERE status = 'active')::int AS sick,
    (SELECT COUNT(*) FROM sk2_players WHERE employment->>'jobId' IS NOT NULL)::int AS employed,
    (SELECT COALESCE(ROUND(AVG(health)), 100) FROM sk2_hospital_patients)::int AS health,
    (SELECT balance FROM sk2_city_treasury WHERE id = 1) AS treasury`)).rows[0];
  await c.query(`INSERT INTO sk2_city_stats (pop, online, money, savings, loans, treasury, sick, employed, health) VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9)`,
    [r.pop, online, r.money, r.savings, r.loans, r.treasury, r.sick, r.employed, r.health]);
}
async function ensureSample(c) {
  const r = (await c.query(`SELECT EXTRACT(EPOCH FROM (now() - MAX(at))) AS age FROM sk2_city_stats`)).rows[0];
  if (r.age === null || Number(r.age) >= CITY.SAMPLE_GAP_S) await sample(c);
}

/* ---------- transições por tempo (leis e eleição), aplicadas na próxima operação ---------- */
const seatedCount = async c => Number((await c.query(`SELECT COUNT(*) AS n FROM sk2_city_offices WHERE office = 'vereador'`)).rows[0].n);
async function settleLaws(c) {
  const due = (await c.query(`SELECT * FROM sk2_city_laws WHERE status = 'voting' AND closes_at <= now() FOR UPDATE`)).rows;
  for (const law of due) {
    const out = lawOutcome({ seats: law.seats, yes: law.yes, no: law.no, expired: true });
    await c.query(`UPDATE sk2_city_laws SET status = $2, closed_at = now() WHERE id = $1`, [law.id, out]);
    if (out === 'approved') await applyPolicy(c, law.kind, law.value, 'camara');
  }
}
async function openElection(c) {
  await c.query(`INSERT INTO sk2_city_elections (closes_at) VALUES (now() + ($1::bigint * interval '1 millisecond'))`, [hoursMs(CITY.ELECTION_DAYS * 24)]);
}
async function settleElection(c, notifies) {
  let el = (await c.query(`SELECT * FROM sk2_city_elections WHERE status = 'open' FOR UPDATE`)).rows[0];
  if (!el) { await openElection(c); return; }
  if (new Date(el.closes_at).getTime() > Date.now()) return;
  const cands = (await c.query('SELECT username, name, platform, created_at FROM sk2_city_candidates WHERE election_id = $1', [el.id])).rows
    .map(r => ({ username: r.username, name: r.name, createdAt: epoch(r.created_at) }));
  const ballots = (await c.query('SELECT candidate FROM sk2_city_ballots WHERE election_id = $1', [el.id])).rows;
  const others = new Set((await c.query(`SELECT username FROM sk2_city_offices WHERE office <> 'vereador'`)).rows.map(r => r.username));
  const mayor = (await c.query(`SELECT username FROM sk2_players WHERE role = 'prefeito'`)).rows.map(r => r.username);
  const eligible = cands.filter(x => !others.has(x.username) && !mayor.includes(x.username));
  const winners = tally(eligible, ballots, CITY.SEATS);
  await c.query(`DELETE FROM sk2_city_offices WHERE office = 'vereador'`);
  for (let i = 0; i < winners.length; i++) {
    await c.query(`INSERT INTO sk2_city_offices (office, slot, username, appointed_by) VALUES ('vereador',$1,$2,'eleicao')`, [i, winners[i].username]);
    await c.query(`INSERT INTO sk2_city_salary (username) VALUES ($1) ON CONFLICT (username) DO UPDATE SET paid_at = now()`, [winners[i].username]);
    notifies.push([winners[i].username, `Você foi eleito vereador(a) com ${winners[i].votes} voto(s)!`]);
  }
  await c.query(`UPDATE sk2_city_elections SET status = 'closed', result = $2 WHERE id = $1`,
    [el.id, JSON.stringify({ winners: winners.map(w => ({ username: w.username, name: w.name, votes: w.votes })), at: Date.now() })]);
  await openElection(c);
}

