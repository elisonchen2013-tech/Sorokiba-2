/* ---------- funções puras (testadas em test/city.test.js) ---------- */
const can = (office, action) => !!office && Array.isArray(PERMS[action]) && PERMS[action].includes(office);
const toInt = v => { const n = typeof v === 'string' && /^-?\d{1,9}$/.test(v) ? Number(v) : v; return Number.isSafeInteger(n) ? n : null; };
function validatePolicy(key, value) {
  const p = POLICIES[key], v = toInt(value);
  if (!p || v === null) return { err: 'Valor inválido.' };
  if (v < p.min || v > p.max) return { err: `${p.label}: use de ${p.min} a ${p.max}.` };
  return { value: v };
}
// Resultado de uma votação: `seats` cadeiras na época da proposta; `expired` quando o prazo acabou.
function lawOutcome({ seats, yes, no, expired }) {
  if (seats > 0 && yes * 2 > seats) return 'approved';
  if (seats > 0 && no * 2 >= seats) return 'rejected';
  if (expired) return yes > no ? 'approved' : 'rejected';
  return 'pending';
}
// Apuração: mais votos primeiro, empate pela candidatura mais antiga; só entra quem teve voto.
function tally(candidates, ballots, seats) {
  const votes = new Map();
  for (const b of ballots) votes.set(b.candidate, (votes.get(b.candidate) || 0) + 1);
  return candidates.map(c => ({ ...c, votes: votes.get(c.username) || 0 }))
    .filter(c => c.votes > 0)
    .sort((a, b) => b.votes - a.votes || a.createdAt - b.createdAt)
    .slice(0, seats);
}
// Salário por dia real completo, com teto de dias acumulados; o resto de tempo é preservado.
function salaryAccrued({ secs, perDay, daySecs, maxDays }) {
  const days = Math.max(0, Math.floor(secs / daySecs)), paid = Math.min(days, maxDays);
  return { days: paid, amount: paid * perDay, remainderSecs: Math.max(0, Math.floor(secs - days * daySecs)) };
}
function aidCheck({ amount, cap, reason }) {
  const a = toInt(amount);
  if (a === null || a < CITY.AID_MIN) return `O pedido mínimo é de R$ ${CITY.AID_MIN}.`;
  if (a > cap) return `O teto por pedido é de R$ ${cap}.`;
  const r = String(reason || '').trim();
  if (r.length < CITY.REASON_MIN) return 'Explique o motivo do pedido (mínimo de 5 caracteres).';
  if (r.length > CITY.REASON_MAX) return `O motivo aceita até ${CITY.REASON_MAX} caracteres.`;
  return null;
}
const clean = (v, max) => String(v ?? '').replace(/[\u0000-\u001f\u007f]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, max);
const brl = n => 'R$ ' + Number(n).toLocaleString('pt-BR');
const epoch = d => (d ? new Date(d).getTime() : null);

/* ---------- estado em memória (cargos para checagens síncronas, como o WebSocket) ---------- */
const officeCache = new Map();           // username -> office
let onlineProvider = () => 0;
const setOnlineProvider = fn => { onlineProvider = typeof fn === 'function' ? fn : () => 0; };
const officeOfUser = username => officeCache.get(username) || null;
const officeOfRow = row => (row && row.role === 'prefeito' ? 'prefeito' : row ? officeOfUser(row.username) : null);
async function reloadOffices(q = db.query) {
  const r = await q('SELECT office, username FROM sk2_city_offices');
  officeCache.clear();
  for (const o of r.rows) officeCache.set(o.username, o.office);
}

