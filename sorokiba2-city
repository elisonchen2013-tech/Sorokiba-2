    .map(l => ({ id: l.id, kind: l.kind, label: POLICIES[l.kind]?.label || l.kind, value: l.value, proposer: l.proposer_name, status: l.status, yes: l.yes, no: l.no, seats: l.seats, closesAt: epoch(l.closes_at), my: l.my || null }));
