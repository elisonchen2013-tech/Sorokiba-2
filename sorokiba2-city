  }
  return {
    serverNow: Date.now(),
    me: { username: u, office, title: office ? OFFICES[office].title : null, salary, can: Object.fromEntries(Object.keys(PERMS).map(k => [k, can(office, k)])) },
    offices, policy: pol, policyInfo: Object.fromEntries(Object.entries(POLICIES).map(([k, v]) => [k, { min: v.min, max: v.max, label: v.label, law: v.law }])),
    kpis, series, jobs, health, laws, election, lastElection: lastEl?.result || null,
    aid: { cap: pol.aid_cap, min: CITY.AID_MIN, mine: myAid, pending }, notices, ledger,
    constants: { lawHours: CITY.LAW_HOURS, seats: CITY.SEATS },
  };
}

/* ---------- operações ---------- */
// Trava o jogador, aplica o que o tempo já decidiu (leis e eleição), roda a regra e devolve o prontuário.
const run = (username, fn) => db.withTx(async c => {
  const locked = (await c.query('SELECT * FROM sk2_players WHERE username = $1 FOR UPDATE', [username])).rows[0];
  if (!locked) return fail('Jogador não encontrado', 404);
  const ctx = { notifies: [], officesChanged: false };
  await settleLaws(c);
  const before = (await c.query(`SELECT COUNT(*) AS n FROM sk2_city_elections WHERE status = 'closed'`)).rows[0].n;
  await settleElection(c, ctx.notifies);
  if (Number((await c.query(`SELECT COUNT(*) AS n FROM sk2_city_elections WHERE status = 'closed'`)).rows[0].n) !== Number(before)) ctx.officesChanged = true;
  const o = (await c.query('SELECT office FROM sk2_city_offices WHERE username = $1', [username])).rows[0];
  const office = locked.role === 'prefeito' ? 'prefeito' : (o ? o.office : null);
  const out = await fn(c, locked, office, ctx);
  if (out.err) return out;
  const player = out.player || locked;
  return { ...out, playerRow: player, city: await snapshot(c, player, office),
    notifies: [...ctx.notifies, ...(out.notifies || [])], officesChanged: ctx.officesChanged || !!out.officesChanged };
});
const noop = (_c, player) => ({ player });
const summary = username => run(username, noop);
const need = (office, action, msg) => (can(office, action) ? null : fail(msg || 'Seu cargo não permite esta ação.', 403));

const publishNotice = (username, text) => run(username, async (c, p, office) => {
  const denied = need(office, 'notice', 'Somente o Prefeito e o Vice podem publicar avisos.'); if (denied) return denied;
  const t = clean(text, CITY.NOTICE_MAX);
  if (t.length < 5) return fail('Escreva o aviso (mínimo de 5 caracteres).', 400);
  if ((await c.query(`SELECT 1 FROM sk2_city_notices WHERE author = $1 AND created_at > now() - ($2::int * interval '1 second')`, [username, CITY.NOTICE_COOLDOWN_S])).rowCount)
    return fail(`Aguarde ${CITY.NOTICE_COOLDOWN_S} segundos entre avisos.`);
  await c.query('INSERT INTO sk2_city_notices (author, author_name, office, text) VALUES ($1,$2,$3,$4)', [username, p.name, office, t]);
  return { player: p, broadcast: { message: t, by: p.name }, message: 'Aviso publicado no quadro e transmitido aos jogadores.' };
});

const appoint = (username, officeKey, targetRaw) => run(username, async (c, p, office) => {
  const denied = need(office, 'appoint', 'Somente o Prefeito nomeia secretários.'); if (denied) return denied;
  if (!APPOINTABLE.includes(officeKey)) return fail('Cargo inválido.', 400);
  const target = String(targetRaw || '').trim().toLowerCase();
  if (!db.validName(target)) return fail('Informe o nome de usuário.', 400);
  const t = (await c.query('SELECT username, name, role FROM sk2_players WHERE username = $1 FOR UPDATE', [target])).rows[0];
  if (!t) return fail('Jogador não encontrado.', 404);
  if (t.role === 'prefeito') return fail('O Prefeito não pode ocupar outro cargo.');
  const has = (await c.query('SELECT office FROM sk2_city_offices WHERE username = $1', [target])).rows[0];
  if (has && has.office !== officeKey) return fail(`${t.name} já ocupa o cargo de ${OFFICES[has.office].title}.`);
  await c.query('DELETE FROM sk2_city_offices WHERE office = $1', [officeKey]);
  await c.query(`INSERT INTO sk2_city_offices (office, slot, username, appointed_by) VALUES ($1,0,$2,$3)`, [officeKey, target, username]);
  await c.query(`INSERT INTO sk2_city_salary (username) VALUES ($1) ON CONFLICT (username) DO UPDATE SET paid_at = now()`, [target]);
  return { player: p, officesChanged: true, notifies: [[target, `Você foi nomeado(a) ${OFFICES[officeKey].title}. Sua mesa fica no 2º andar da Prefeitura.`]],
    message: `${t.name} nomeado(a) ${OFFICES[officeKey].title}.` };
});

const dismiss = (username, officeKey) => run(username, async (c, p, office) => {
  const denied = need(office, 'appoint', 'Somente o Prefeito exonera secretários.'); if (denied) return denied;
  if (!APPOINTABLE.includes(officeKey)) return fail('Cargo inválido.', 400);
  const r = await c.query('DELETE FROM sk2_city_offices WHERE office = $1 RETURNING username', [officeKey]);
  if (!r.rowCount) return fail('Este cargo já está vago.');
  return { player: p, officesChanged: true, notifies: [[r.rows[0].username, `Você foi exonerado(a) do cargo de ${OFFICES[officeKey].title}.`]], message: 'Cargo declarado vago.' };
});

const proposeLaw = (username, kind, value) => run(username, async (c, p, office) => {
  const denied = need(office, 'propose', 'Somente o Prefeito e o Vice propõem leis.'); if (denied) return denied;
  if (!POLICIES[kind] || !POLICIES[kind].law) return fail('Esta política não é alterada por lei.', 400);
  const v = validatePolicy(kind, value); if (v.err) return fail(v.err, 400);
  if ((await policy(c, kind)) === v.value) return fail('Este valor já está em vigor.');
  if ((await c.query(`SELECT 1 FROM sk2_city_laws WHERE kind = $1 AND status = 'voting'`, [kind])).rowCount) return fail('Já existe uma votação em andamento para esta política.');
  const seats = await seatedCount(c), id = crypto.randomUUID();
  if (seats === 0) {
    await c.query(`INSERT INTO sk2_city_laws (id, kind, value, proposer, proposer_name, status, closes_at, closed_at, seats) VALUES ($1,$2,$3,$4,$5,'decreed', now(), now(), 0)`, [id, kind, v.value, username, p.name]);
    await applyPolicy(c, kind, v.value, username);
    return { player: p, message: `Sem Câmara instalada: decreto publicado. ${POLICIES[kind].label} = ${v.value}.` };
  }
  await c.query(`INSERT INTO sk2_city_laws (id, kind, value, proposer, proposer_name, closes_at, seats) VALUES ($1,$2,$3,$4,$5, now() + ($6::bigint * interval '1 millisecond'), $7)`,
    [id, kind, v.value, username, p.name, hoursMs(CITY.LAW_HOURS), seats]);
  const vs = (await c.query(`SELECT username FROM sk2_city_offices WHERE office = 'vereador'`)).rows;
  return { player: p, notifies: vs.map(r => [r.username, `Nova lei em votação: ${POLICIES[kind].label} = ${v.value}. Vote no Plenário.`]), message: 'Projeto enviado à Câmara para votação.' };
});

const voteLaw = (username, lawId, vote) => run(username, async (c, p, office) => {
  const denied = need(office, 'vote', 'Somente vereadores votam leis.'); if (denied) return denied;
  if (!UUID.test(String(lawId)) || (vote !== 'yes' && vote !== 'no')) return fail('Voto inválido.', 400);
  const law = (await c.query(`SELECT * FROM sk2_city_laws WHERE id = $1 AND status = 'voting' FOR UPDATE`, [lawId])).rows[0];
  if (!law) return fail('Esta votação já foi encerrada.');
  if ((await c.query('SELECT 1 FROM sk2_city_law_votes WHERE law_id = $1 AND voter = $2', [lawId, username])).rowCount) return fail('Você já votou nesta lei.');
  await c.query('INSERT INTO sk2_city_law_votes (law_id, voter, vote) VALUES ($1,$2,$3)', [lawId, username, vote]);
  const yes = law.yes + (vote === 'yes' ? 1 : 0), no = law.no + (vote === 'no' ? 1 : 0);
  const out = lawOutcome({ seats: law.seats, yes, no, expired: false });
  if (out === 'pending') {
    await c.query('UPDATE sk2_city_laws SET yes = $2, no = $3 WHERE id = $1', [lawId, yes, no]);
    return { player: p, message: 'Voto registrado. A votação continua aberta.' };
  }
  await c.query('UPDATE sk2_city_laws SET yes = $2, no = $3, status = $4, closed_at = now() WHERE id = $1', [lawId, yes, no, out]);
  if (out === 'approved') await applyPolicy(c, law.kind, law.value, 'camara');
  return { player: p, message: out === 'approved' ? 'Lei aprovada e em vigor!' : 'Lei rejeitada pela Câmara.' };
});

const setSubsidy = (username, pct) => run(username, async (c, p, office) => {
  const denied = need(office, 'subsidy', 'Somente o Secretário de Saúde define o subsídio.'); if (denied) return denied;
  const v = validatePolicy('health_subsidy_pct', pct); if (v.err) return fail(v.err, 400);
  const max = await policy(c, 'health_subsidy_max');
  if (v.value > max) return fail(`A lei em vigor limita o subsídio a ${max}%.`);
  await applyPolicy(c, 'health_subsidy_pct', v.value, username);
  return { player: p, message: `Subsídio da saúde em ${v.value}%. Vale para consultas, exames e sessões no Hospital.` };
});

const requestAid = (username, amount, reason) => run(username, async (c, p) => {
  const cap = await policy(c, 'aid_cap'), bad = aidCheck({ amount, cap, reason });
  if (bad) return fail(bad, 400);
  if ((await c.query(`SELECT 1 FROM sk2_city_aid WHERE username = $1 AND status = 'pending'`, [username])).rowCount) return fail('Você já tem um pedido aguardando análise.');
  if ((await c.query(`SELECT 1 FROM sk2_city_aid WHERE username = $1 AND status = 'approved' AND decided_at > now() - ($2::bigint * interval '1 millisecond')`, [username, hoursMs(CITY.AID_COOLDOWN_H)])).rowCount)
    return fail(`Você recebeu um auxílio nas últimas ${CITY.AID_COOLDOWN_H} horas.`);
  await c.query('INSERT INTO sk2_city_aid (id, username, name, amount, reason) VALUES ($1,$2,$3,$4,$5)', [crypto.randomUUID(), username, p.name, toInt(amount), clean(reason, CITY.REASON_MAX)]);
  return { player: p, message: 'Pedido protocolado. O Secretário de Finanças vai analisar.' };
});

const decideAid = (username, id, approve) => run(username, async (c, p, office) => {
  const denied = need(office, 'aid_decide', 'Somente Finanças e o Prefeito decidem auxílios.'); if (denied) return denied;
  if (!UUID.test(String(id))) return fail('Pedido inválido.', 400);
  const aid = (await c.query(`SELECT * FROM sk2_city_aid WHERE id = $1 AND status = 'pending' FOR UPDATE`, [id])).rows[0];
  if (!aid) return fail('Este pedido já foi decidido.');
  if (aid.username === username) return fail('Você não pode decidir o próprio pedido.');
  if (!approve) {
    await c.query(`UPDATE sk2_city_aid SET status = 'denied', decided_by = $2, decided_at = now() WHERE id = $1`, [id, username]);
    return { player: p, notifies: [[aid.username, `Seu pedido de auxílio de ${brl(aid.amount)} foi negado.`]], message: 'Pedido negado.' };
  }
  const who = (await c.query('SELECT money FROM sk2_players WHERE username = $1 FOR UPDATE', [aid.username])).rows[0];
  if (!who) return fail('Cidadão não encontrado.', 404);
  if (who.money + aid.amount > 2147483647) return fail('A carteira do cidadão não comporta esse valor.');
  if ((await debit(c, 'auxilio', aid.amount, `Auxílio a ${aid.name}`)) === null) return fail('O tesouro não tem saldo suficiente para este auxílio.');
  await c.query('UPDATE sk2_players SET money = money + $2 WHERE username = $1', [aid.username, aid.amount]);
  await c.query(`UPDATE sk2_city_aid SET status = 'approved', decided_by = $2, decided_at = now() WHERE id = $1`, [id, username]);
  return { player: p, notifies: [[aid.username, `Seu auxílio de ${brl(aid.amount)} foi aprovado e já está na sua carteira.`]], message: `Auxílio de ${brl(aid.amount)} pago a ${aid.name}.` };
});

const claimSalary = username => run(username, async (c, p, office) => {
  if (!office) return fail('Você não ocupa nenhum cargo.', 403);
  await c.query('INSERT INTO sk2_city_salary (username) VALUES ($1) ON CONFLICT DO NOTHING', [username]);
  const s = (await c.query('SELECT EXTRACT(EPOCH FROM (now() - paid_at)) AS secs FROM sk2_city_salary WHERE username = $1 FOR UPDATE', [username])).rows[0];
  const a = salaryAccrued({ secs: Number(s.secs), perDay: OFFICES[office].salary, daySecs: hoursMs(24) / 1000, maxDays: CITY.SALARY_MAX_DAYS });
  if (a.days < 1) return fail('Ainda não há dia completo de trabalho a receber.');
  if (p.money + a.amount > 2147483647) return fail('Sua carteira não comporta esse valor.');
  if ((await debit(c, 'salario', a.amount, `Salário de ${p.name} (${OFFICES[office].title})`)) === null) return fail('O tesouro não tem saldo para pagar o salário agora.');
  const player = (await c.query('UPDATE sk2_players SET money = money + $2 WHERE username = $1 RETURNING *', [username, a.amount])).rows[0];
  await c.query(`UPDATE sk2_city_salary SET paid_at = now() - ($2::bigint * interval '1 second') WHERE username = $1`, [username, a.remainderSecs]);
  return { player, message: `Salário de ${a.days} dia(s) recebido: ${brl(a.amount)}.` };
});

const runForCouncil = (username, platform) => run(username, async (c, p, office) => {
  if (Number(p.xp) < CITY.CANDIDATE_MIN_XP) return fail(`Candidatura exige ${CITY.CANDIDATE_MIN_XP} XP.`, 403);
  if (office && office !== 'vereador') return fail('Quem já ocupa outro cargo não pode se candidatar.');
  const text = clean(platform, CITY.PLATFORM_MAX);
  if (text.length < 5) return fail('Escreva a sua proposta (mínimo de 5 caracteres).', 400);
  const el = (await c.query(`SELECT id FROM sk2_city_elections WHERE status = 'open'`)).rows[0];
  if (!el) return fail('Não há eleição aberta.');
  await c.query(`INSERT INTO sk2_city_candidates (election_id, username, name, platform) VALUES ($1,$2,$3,$4)
    ON CONFLICT (election_id, username) DO UPDATE SET platform = EXCLUDED.platform`, [el.id, username, p.name, text]);
  return { player: p, message: 'Candidatura registrada para a Câmara.' };
});

const castVote = (username, candidateRaw) => run(username, async (c, p) => {
  if (Number(p.xp) < CITY.VOTE_MIN_XP) return fail(`Votar exige ${CITY.VOTE_MIN_XP} XP.`, 403);
  const cand = String(candidateRaw || '').trim().toLowerCase();
  if (!db.validName(cand)) return fail('Candidato inválido.', 400);
  if (cand === username) return fail('Você não pode votar em si mesmo.');
  const el = (await c.query(`SELECT id FROM sk2_city_elections WHERE status = 'open'`)).rows[0];
  if (!el) return fail('Não há eleição aberta.');
  if (!(await c.query('SELECT 1 FROM sk2_city_candidates WHERE election_id = $1 AND username = $2', [el.id, cand])).rowCount) return fail('Esse morador não é candidato.');
  const r = await c.query('INSERT INTO sk2_city_ballots (election_id, voter, candidate) VALUES ($1,$2,$3) ON CONFLICT DO NOTHING', [el.id, username, cand]);
  if (!r.rowCount) return fail('Você já votou nesta eleição.');
  return { player: p, message: 'Voto registrado. Obrigado por participar!' };
});

async function sweep() { await db.withTx(async c => { await sample(c); return {}; }); }

/* ---------- rotas ---------- */
function registerRoutes({ app, json, authUser, limited, userTries, addInterval, notify = () => {}, broadcast = () => {} }) {
  addInterval(() => { sweep().catch(e => console.error('[sk2] prefeitura (estatísticas):', e.message)); }, 10 * 60e3);
  const guard = fn => async (req, res) => {
    try {
      const row = await authUser(req);
      if (!row) return res.status(401).json({ err: 'Sessão expirada' });
      if (limited(userTries, `city:${row.username}`, 60)) return res.status(429).json({ err: 'Muitas ações na Prefeitura. Aguarde um minuto.' });
      await fn(req, res, row);
    } catch (e) {
      console.error('[sk2] prefeitura:', e.message);
      if (!res.headersSent) res.status(500).json({ err: 'Não foi possível concluir a operação na Prefeitura.' });
    }
  };
  const done = async (res, r) => {
    if (r.err) return res.status(r.status || 409).json({ err: r.err });
    if (r.officesChanged) await reloadOffices();
    for (const [u, m] of r.notifies || []) notify(u, { t: 'city', m });
    if (r.broadcast) broadcast({ t: 'mayorAnnouncement', message: r.broadcast.message, by: r.broadcast.by, at: Date.now() });
    res.json({ ok: 1, player: db.pub(r.playerRow), city: r.city, message: r.message || '' });
  };
  const bad = (res, m) => res.status(400).json({ err: m });
  app.get('/api/sk2/city', guard(async (_q, res, row) => { res.set('Cache-Control', 'no-store'); await done(res, await summary(row.username)); }));
  app.post('/api/sk2/city/notice', json, guard(async (req, res, row) => {
    if (typeof req.body?.text !== 'string') return bad(res, 'Escreva o aviso.');
    await done(res, await publishNotice(row.username, req.body.text));
  }));
  app.post('/api/sk2/city/office/appoint', json, guard(async (req, res, row) => {
    const o = req.body?.office, u = req.body?.username;
    if (typeof o !== 'string' || !APPOINTABLE.includes(o) || typeof u !== 'string') return bad(res, 'Cargo ou usuário inválido.');
    await done(res, await appoint(row.username, o, u));
  }));
  app.post('/api/sk2/city/office/dismiss', json, guard(async (req, res, row) => {
    const o = req.body?.office;
    if (typeof o !== 'string' || !APPOINTABLE.includes(o)) return bad(res, 'Cargo inválido.');
    await done(res, await dismiss(row.username, o));
  }));
  app.post('/api/sk2/city/law/propose', json, guard(async (req, res, row) => {
    const k = req.body?.kind;
    if (typeof k !== 'string' || !Object.prototype.hasOwnProperty.call(POLICIES, k) || !POLICIES[k].law) return bad(res, 'Política inválida.');
    const v = validatePolicy(k, req.body?.value); if (v.err) return bad(res, v.err);
    await done(res, await proposeLaw(row.username, k, v.value));
  }));
  app.post('/api/sk2/city/law/vote', json, guard(async (req, res, row) => {
    if (!UUID.test(String(req.body?.id)) || (req.body?.vote !== 'yes' && req.body?.vote !== 'no')) return bad(res, 'Voto inválido.');
    await done(res, await voteLaw(row.username, req.body.id, req.body.vote));
  }));
  app.post('/api/sk2/city/policy/subsidy', json, guard(async (req, res, row) => {
    const v = validatePolicy('health_subsidy_pct', req.body?.pct); if (v.err) return bad(res, v.err);
    await done(res, await setSubsidy(row.username, v.value));
  }));
  app.post('/api/sk2/city/aid/request', json, guard(async (req, res, row) => {
    const cap = POLICIES.aid_cap.max, a = toInt(req.body?.amount);
    if (a === null || a < CITY.AID_MIN || a > cap || typeof req.body?.reason !== 'string') return bad(res, 'Informe o valor e o motivo do pedido.');
    await done(res, await requestAid(row.username, a, req.body.reason));
  }));
  app.post('/api/sk2/city/aid/decide', json, guard(async (req, res, row) => {
    if (!UUID.test(String(req.body?.id)) || typeof req.body?.approve !== 'boolean') return bad(res, 'Pedido inválido.');
    await done(res, await decideAid(row.username, req.body.id, req.body.approve));
  }));
  app.post('/api/sk2/city/salary/claim', json, guard(async (_q, res, row) => done(res, await claimSalary(row.username))));
  app.post('/api/sk2/city/election/candidate', json, guard(async (req, res, row) => {
    if (typeof req.body?.platform !== 'string') return bad(res, 'Escreva a sua proposta.');
    await done(res, await runForCouncil(row.username, req.body.platform));
  }));
  app.post('/api/sk2/city/election/vote', json, guard(async (req, res, row) => {
    if (typeof req.body?.candidate !== 'string') return bad(res, 'Candidato inválido.');
    await done(res, await castVote(row.username, req.body.candidate));
  }));
}

