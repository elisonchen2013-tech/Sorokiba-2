    .map(s => ({ t: epoch(s.at), pop: s.pop, online: s.online, money: Number(s.money), savings: Number(s.savings), loans: Number(s.loans), treasury: Number(s.treasury), sick: s.sick, employed: s.employed, health: s.health }));
