// SK2_CITY_TIME_SCALE=0.001 comprime prazos (leis, eleição, salário) para testar. Em produção: 1.
const SCALE = (() => { const n = Number(process.env.SK2_CITY_TIME_SCALE); return n > 0 && n <= 1 ? n : 1; })();
const hoursMs = h => Math.max(1000, Math.round(h * 3600e3 * SCALE));

