  const open = (await c.query('SELECT id, week, kind, amount, fine, due_at FROM sk2_biz_bills WHERE store_id = $1 AND paid_at IS NULL ORDER BY due_at, kind FOR UPDATE', [store.id])).rows
    .map(r => ({ id: r.id, week: Number(r.week), kind: r.kind, amount: r.amount, fine: r.fine, dueAt: epoch(r.due_at) }));
