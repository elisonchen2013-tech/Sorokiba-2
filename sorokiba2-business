function registerRoutes({ app, json, authUser, limited, userTries }) {
  const guard = fn => async (req, res) => {
    try {
      const row = await authUser(req);
      if (!row) return res.status(401).json({ err: 'Sessão expirada' });
      if (limited(userTries, `biz:${row.username}`, 60)) return res.status(429).json({ err: 'Muitas ações nas Empresas. Aguarde um minuto.' });
      await fn(req, res, row);
    } catch (e) {
      console.error('[sk2] empresas:', e.message);
      if (!res.headersSent) res.status(500).json({ err: 'Não foi possível concluir a operação da empresa.' });
    }
  };
  const done = (res, r) => {
    if (r.err) return res.status(r.status || 409).json({ err: r.err });
    const sold = r.settled && r.settled.revenue > 0 ? { revenue: r.settled.revenue, units: r.settled.units, customers: r.settled.customers } : null;
    res.json({ ok: 1, player: db.pub(r.playerRow), business: r.business, event: r.event || null, sales: sold, settled: r.settled ? { bills: r.settled.bills, suspended: r.settled.suspended, reopened: r.settled.reopened } : null, message: r.message || '' });
  };
  const bad = (res, m) => res.status(400).json({ err: m });
  const obj = b => b && typeof b === 'object' && !Array.isArray(b);
  app.get('/api/sk2/business', guard(async (_q, res, row) => { res.set('Cache-Control', 'no-store'); done(res, await summary(row.username)); }));
  app.post('/api/sk2/business/buy', json, guard(async (req, res, row) => { if (!obj(req.body)) return bad(res, 'Dados da loja inválidos.'); done(res, await buyLot(row.username, req.body)); }));
  app.post('/api/sk2/business/brand', json, guard(async (req, res, row) => { if (!obj(req.body)) return bad(res, 'Dados da marca inválidos.'); done(res, await saveBrand(row.username, req.body)); }));
  app.post('/api/sk2/business/products', json, guard(async (req, res, row) => { if (!Array.isArray(req.body?.slots)) return bad(res, 'Envie os produtos da loja.'); done(res, await setProducts(row.username, req.body.slots)); }));
  app.post('/api/sk2/business/restock', json, guard(async (req, res, row) => { if (!obj(req.body)) return bad(res, 'Pedido inválido.'); done(res, await restock(row.username, req.body)); }));
  app.post('/api/sk2/business/decor', json, guard(async (req, res, row) => { if (!obj(req.body)) return bad(res, 'Pedido inválido.'); done(res, await buyDecor(row.username, req.body)); }));
  app.post('/api/sk2/business/open', json, guard(async (req, res, row) => done(res, await setOpen(row.username, req.body?.open))));
  app.post('/api/sk2/business/autopay', json, guard(async (req, res, row) => done(res, await setAutopay(row.username, req.body?.on))));
  app.post('/api/sk2/business/withdraw', json, guard(async (req, res, row) => done(res, await withdraw(row.username, req.body?.amount))));
  app.post('/api/sk2/business/bills/pay', json, guard(async (req, res, row) => { if (!obj(req.body)) return bad(res, 'Pedido inválido.'); done(res, await payBills(row.username, req.body)); }));
  app.post('/api/sk2/business/sell', json, guard(async (_q, res, row) => done(res, await sellStore(row.username))));
  app.post('/api/sk2/business/shop/buy', json, guard(async (req, res, row) => { if (!obj(req.body)) return bad(res, 'Pedido inválido.'); done(res, await shopBuy(row.username, req.body)); }));
  app.post('/api/sk2/business/bag/use', json, guard(async (req, res, row) => { if (typeof req.body?.item !== 'string') return bad(res, 'Escolha o item.'); done(res, await useItem(row.username, req.body.item)); }));
}

