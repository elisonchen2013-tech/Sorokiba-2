  for (let w = firstWeek; w < W; w++) {
    const rev = Number((await c.query('SELECT COALESCE(SUM(revenue),0) AS r FROM sk2_biz_days WHERE store_id = $1 AND day >= $2 AND day < $3', [store.id, w * 7, w * 7 + 7])).rows[0].r);
    for (const b of weekBills(lot, store.pricePaid, store.boughtAt, w, rev)) {
      const id = crypto.randomUUID();
      const ins = await c.query('INSERT INTO sk2_biz_bills (id, store_id, week, kind, amount, due_at) VALUES ($1,$2,$3,$4,$5, to_timestamp($6::double precision / 1000)) ON CONFLICT DO NOTHING', [id, store.id, w, b.kind, b.amount, b.due]);
      if (ins.rowCount) out.bills++;
    }
