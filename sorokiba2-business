  else { if (Number(player.money) < total) return false; player.money = Number(player.money) - total; await c.query('UPDATE sk2_players SET money = money - $2 WHERE username = $1', [player.username, total]); }
  await c.query('UPDATE sk2_biz_bills SET paid_at = now(), paid_day = $2, fine = $3 WHERE id = $1', [row.id, dayOf(Date.now()), row.fine]);
  await city.credit(c, ledgerKind(row.kind), total, `${BILL_LABEL[row.kind]} de ${store.name}`);
  return true;
}
