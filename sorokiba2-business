const shopBuy = (username, input) => run(username, async (c, p) => {
  if (!UUID.test(String(input?.store))) return fail('Loja inválida.', 400);
  const qty = input?.qty ?? 1; if (!Number.isInteger(qty) || qty < 1 || qty > BIZ.BUY_QTY_MAX) return fail(`Compre de 1 a ${BIZ.BUY_QTY_MAX} unidades por vez.`, 400);
  const r = (await c.query('SELECT * FROM sk2_biz_stores WHERE id = $1 FOR UPDATE', [input.store])).rows[0]; if (!r) return fail('Loja não encontrada.', 404);
  const s = toStore(r); if (s.owner === username) return fail('Você não pode comprar da própria loja.');
  await settleStore(c, s, Date.now(), null);
  if (s.status !== 'aberta') { await saveStore(c, s); return fail(s.status === 'suspensa' ? 'Esta loja está suspensa.' : 'Esta loja está fechada agora.'); }
  const slot = s.products.find(x => x && x.id === input.product); if (!slot) return fail('Produto não encontrado nesta loja.', 404);
  if (slot.stock < qty) { await saveStore(c, s); return fail(slot.stock ? `Só restam ${slot.stock} unidade(s).` : 'Produto esgotado.'); }
  const total = slot.price * qty; if (Number(p.money) < total) { await saveStore(c, s); return fail(`Saldo insuficiente: ${brl(total)}.`); }
  const bag = Number((await c.query('SELECT qty FROM sk2_biz_bag WHERE username = $1 AND item_id = $2 FOR UPDATE', [username, slot.id])).rows[0]?.qty || 0);
  if (bag + qty > BIZ.BAG_MAX) { await saveStore(c, s); return fail(`Sua sacola comporta até ${BIZ.BAG_MAX} unidades de cada item.`); }
  const player = (await c.query('UPDATE sk2_players SET money = money - $2 WHERE username = $1 RETURNING *', [username, total])).rows[0];
  slot.stock -= qty; slot.sold = (slot.sold || 0) + qty; s.cash += total; s.reputation = clamp(s.reputation + 0.004 * qty, BIZ.REP_MIN, BIZ.REP_MAX);
  await addDay(c, s.id, dayOf(Date.now()), { revenue: total, units: qty, customers: 1 }); await saveStore(c, s);
  await c.query('INSERT INTO sk2_biz_bag (username, item_id, qty) VALUES ($1,$2,$3) ON CONFLICT (username, item_id) DO UPDATE SET qty = sk2_biz_bag.qty + EXCLUDED.qty', [username, slot.id, qty]);
  return { player, event: { kind: 'shopBuy' }, message: `${qty}× ${PRODUCT_BY_ID[slot.id].name} da ${s.name}: ${brl(total)}. Veja na sua sacola.` };
}, { own: false });
const useItem = (username, itemId) => run(username, async (c, p) => {
  if (!hasOwn(PRODUCT_BY_ID, itemId)) return fail('Item inválido.', 400);
  const pr = PRODUCT_BY_ID[itemId]; if (!(pr.heal > 0)) return fail(`${pr.name} não é de comer: guarde na sacola.`);
  const row = (await c.query('SELECT qty FROM sk2_biz_bag WHERE username = $1 AND item_id = $2 FOR UPDATE', [username, itemId])).rows[0];
  if (!row || row.qty < 1) return fail('Você não tem este item na sacola.');
  const st = await hospital.settle(c, p); if (st.health >= 100) return fail('Sua saúde já está no máximo.');
  const gain = Math.min(pr.heal, 100 - st.health);
  await c.query('UPDATE sk2_hospital_patients SET health = $2, health_at = now() WHERE username = $1', [username, st.health + gain]);
  await c.query('UPDATE sk2_biz_bag SET qty = qty - 1 WHERE username = $1 AND item_id = $2', [username, itemId]);
  return { player: p, event: { kind: 'eat' }, message: `${pr.name}: +${gain} de saúde (agora ${st.health + gain}%).` };
}, { own: false });

