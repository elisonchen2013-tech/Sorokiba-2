/* ---------- funções puras (testadas em test/business.test.js) ---------- */
const brl = n => 'R$ ' + Number(n).toLocaleString('pt-BR');
const clean = (v, max) => String(v ?? '').replace(/[\u0000-\u001f\u007f<>]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, max);
const hasOwn = (o, k) => typeof k === 'string' && Object.prototype.hasOwnProperty.call(o, k);
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const epoch = d => (d ? new Date(d).getTime() : null);
const tickOf = ms => Math.floor(ms / TICK_MS), dayOf = ms => Math.floor(ms / DAY_MS), weekOf = ms => Math.floor(ms / WEEK_MS);
function mulberry32(seed) { let a = seed >>> 0; return () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
const hashStr = s => { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; };
const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
const unitCost = (product, q) => Math.max(1, Math.round(product.ref * BIZ.COST_BASE_PCT / 100 * (BIZ.QUALITY_COST[q] || 1)));
const priceRange = product => ({ min: Math.max(1, Math.ceil(product.ref * BIZ.PRICE_MIN_PCT / 100)), max: Math.floor(product.ref * BIZ.PRICE_MAX_PCT / 100) });
// Quanto o preço afasta o cliente: 1,35 muito barato, 1,0 no preço de referência, perto de 0 em dobro do preço.
function priceFactor(price, ref) {
  const r = price / ref;
  if (r <= 0.6) return 1.35;
  if (r <= 1) return 1.35 - (r - 0.6) * 0.875;
  return Math.max(0.12, 1 - (r - 1) * 0.88);
}
const decorAppeal = decor => Math.min(BIZ.DECOR_APPEAL_CAP, Object.entries(decor || {}).reduce((s, [sock, id]) => s + (DECOR_BY_ID[`${sock}:${id}`]?.appeal || 0), 0));
function premiumShare(slots) { const act = (slots || []).filter(s => s && s.id); return act.length ? act.filter(s => s.q === 'p').length / act.length : 0; }
const appealOf = store => 1 + decorAppeal(store.decor) / 100 + (Number(store.reputation || 1) - 1) * 0.5 + premiumShare(store.products) * 0.1;
const hourWave = tick => 0.25 + 0.75 * (0.5 + 0.5 * Math.sin(2 * Math.PI * ((((tick % 24) + 24) % 24) - 9) / 24));
// Uma "hora" de movimento. Sorteio fixo por loja e hora: repetir a conta dá sempre o mesmo resultado.
function simulateTick(store, lot, tick) {
  const rnd = mulberry32(hashStr(store.id + ':' + tick)), slots = store.products.map(s => (s ? { ...s } : s));
  const E = lot.traffic * BIZ.SIZE_FACTOR[lot.size] * (BIZ.DEMAND[store.category] || 1) * BIZ.CUSTOMER_SCALE * appealOf(store) * hourWave(tick), customers = Math.floor(E) + (rnd() < E - Math.floor(E) ? 1 : 0);
  let revenue = 0, units = 0, missed = 0, left = 0;
  for (let c = 0; c < customers; c++) {
    const live = slots.map((s, i) => ({ s, i })).filter(({ s }) => s && s.id && s.stock > 0);
    if (!live.length) { missed++; continue; }
    const w = live.map(({ s }) => { const p = PRODUCT_BY_ID[s.id]; return p.pop * priceFactor(s.price, p.ref) * (BIZ.QUALITY_APPEAL[s.q] || 1); }), tot = w.reduce((a, b) => a + b, 0);
    let pick = rnd() * tot, k = 0; while (k < w.length - 1 && pick > w[k]) { pick -= w[k]; k++; }
    const slot = live[k].s, pf = priceFactor(slot.price, PRODUCT_BY_ID[slot.id].ref);
    if (rnd() > clamp(0.25 + 0.5 * pf, 0.1, 0.9)) { left++; continue; }
    const n = Math.min(rnd() < 0.35 ? 2 : 1, slot.stock);
    slot.stock -= n; slot.sold = (slot.sold || 0) + n; revenue += n * slot.price; units += n;
  }
  return { customers, revenue, units, missed, left, slots };
}
// Roda várias horas e agrega por dia. A reputação sobe com cliente atendido e cai quando falta produto.
function simulate(store, lot, fromTick, toTick, cap = BIZ.MAX_OFFLINE_TICKS) {
  const days = new Map();
  let slots = store.products, rep = Number(store.reputation || 1), revenue = 0;
  const start = Math.max(fromTick + 1, toTick - cap + 1);
  for (let t = start; t <= toTick; t++) {
    const r = simulateTick({ ...store, products: slots, reputation: rep }, lot, t);
    slots = r.slots;
    const d = dayOf(t * TICK_MS), cur = days.get(d) || { revenue: 0, units: 0, customers: 0, missed: 0 };
    cur.revenue += r.revenue; cur.units += r.units; cur.customers += r.customers; cur.missed += r.missed; days.set(d, cur);
    revenue += r.revenue;
    if (r.customers > 0) rep = clamp(rep + (r.units / r.customers - 0.45) * 0.02 - r.missed / r.customers * 0.015, BIZ.REP_MIN, BIZ.REP_MAX);
  }
  return { days, products: slots, reputation: Math.round(rep * 1000) / 1000, revenue, ticks: Math.max(0, toTick - start + 1) };
}
// Valores da semana: alvará e imposto predial proporcionais aos dias em que a loja existiu; ISS sobre o faturamento.
function weekBills(lot, pricePaid, boughtAt, week, weekRevenue) {
  const ws = week * WEEK_MS, we = ws + WEEK_MS, from = Math.max(ws, boughtAt), owned = clamp((we - from) / DAY_MS, 1, 7), f = owned / 7;
  const due = we + BIZ.BILL_DUE_DAYS * DAY_MS;
  return [{ kind: 'alvara', amount: Math.max(1, Math.round(lot.alvara * f)), due }, { kind: 'iptu', amount: Math.max(1, Math.round(pricePaid * BIZ.IPTU_PCT / 100 * f)), due },
    { kind: 'iss', amount: Math.round(Math.max(0, weekRevenue) * BIZ.ISS_PCT / 100), due }].filter(b => b.amount > 0);
}
const billState = (bill, now) => {
  const overdue = !bill.paidAt && Number(bill.dueAt) < now, fine = bill.fine || (overdue ? Math.round(bill.amount * BIZ.FINE_PCT / 100) : 0);
  return { overdue, fine, total: bill.amount + fine, suspendAt: Number(bill.dueAt) + BIZ.SUSPEND_AFTER_DAYS * DAY_MS, daysLate: overdue ? Math.floor((now - Number(bill.dueAt)) / DAY_MS) : 0 };
};
function validateBrand(b) {
  const name = clean(b && b.name, BIZ.NAME_MAX);
  if (name.length < BIZ.NAME_MIN) return { err: `O nome da loja precisa de pelo menos ${BIZ.NAME_MIN} letras.` };
  if (!/[\p{L}\p{N}]/u.test(name)) return { err: 'O nome da loja precisa de letras ou números.' };
  const logo = LOGOS.includes(b.logo) ? b.logo : null, palette = Number.isInteger(b.palette) && b.palette >= 0 && b.palette < PALETTES.length ? b.palette : null;
  if (logo === null || palette === null || !FLOORS.includes(b.floor) || !SIGNS.includes(b.sign)) return { err: 'Escolha o logotipo, as cores, o piso e a placa da loja.' };
  return { name, logo, palette, floor: b.floor, sign: b.sign };
}
// Confere os produtos escolhidos: só da categoria da loja, no limite de vagas do terreno e preço dentro da faixa.
function validateSlots(category, lot, input, current = []) {
  if (!Array.isArray(input) || !input.length) return { err: 'Escolha pelo menos um produto.' };
  if (input.length > lot.slots) return { err: `Este terreno tem ${lot.slots} vagas de produto.` };
  const seen = new Set(), out = [];
  for (const s of input) {
    const p = s && hasOwn(PRODUCT_BY_ID, s.id) ? PRODUCT_BY_ID[s.id] : null;
    if (!p || p.cat !== category) return { err: 'Há um produto que não é da categoria da loja.' };
    if (seen.has(p.id)) return { err: 'Não repita o mesmo produto em duas vagas.' };
    seen.add(p.id);
    if (!Number.isInteger(s.price)) return { err: 'O preço precisa ser um número inteiro.' };
    const r = priceRange(p); if (s.price < r.min || s.price > r.max) return { err: `${p.name}: o preço vai de ${brl(r.min)} a ${brl(r.max)}.` };
    if (s.q !== 'b' && s.q !== 'p') return { err: 'Escolha a qualidade do produto.' };
    const old = current.find(c => c && c.id === p.id);
    if (old && old.stock > 0 && old.q !== s.q) return { err: `${p.name}: só dá para mudar a qualidade com o estoque zerado.` };
    out.push({ id: p.id, price: s.price, q: s.q, stock: old ? old.stock : 0, sold: old ? old.sold || 0 : 0 });
  }
  const dropped = current.filter(c => c && c.id && !seen.has(c.id) && c.stock > 0);
  if (dropped.length) return { err: `Venda ou zere o estoque antes de tirar ${PRODUCT_BY_ID[dropped[0].id]?.name || 'o produto'} da loja.` };
  return { slots: out };
}
const lotView = l => ({ id: l.id, name: l.name, size: l.size, sizeLabel: SIZES[l.size].label, x: l.x, y: l.y, w: l.w, h: l.h, traffic: l.traffic, price: l.price, area: l.area, slots: l.slots, alvara: l.alvara, iptuWeek: Math.round(l.price * BIZ.IPTU_PCT / 100) });

/* ---------- banco de dados ---------- */
async function init() {
  await db.query(`CREATE TABLE IF NOT EXISTS sk2_biz_stores (
    id UUID PRIMARY KEY, lot TEXT NOT NULL UNIQUE, owner TEXT NOT NULL UNIQUE REFERENCES sk2_players(username) ON DELETE CASCADE, owner_name TEXT NOT NULL,
    name TEXT NOT NULL, category TEXT NOT NULL, logo TEXT NOT NULL, palette INT NOT NULL, floor TEXT NOT NULL, sign TEXT NOT NULL,
    decor JSONB NOT NULL DEFAULT '{}', products JSONB NOT NULL DEFAULT '[]', cash INT NOT NULL DEFAULT 0 CHECK (cash >= 0), price_paid INT NOT NULL,
    bought_at TIMESTAMPTZ NOT NULL DEFAULT now(), last_tick BIGINT NOT NULL, billed_week BIGINT NOT NULL, status TEXT NOT NULL DEFAULT 'aberta' CHECK (status IN ('aberta','fechada','suspensa')),
    reputation REAL NOT NULL DEFAULT 1, autopay BOOLEAN NOT NULL DEFAULT false);
  CREATE TABLE IF NOT EXISTS sk2_biz_days (
    store_id UUID NOT NULL REFERENCES sk2_biz_stores(id) ON DELETE CASCADE, day BIGINT NOT NULL, revenue INT NOT NULL DEFAULT 0, spent INT NOT NULL DEFAULT 0,
    units INT NOT NULL DEFAULT 0, customers INT NOT NULL DEFAULT 0, missed INT NOT NULL DEFAULT 0, PRIMARY KEY (store_id, day));
  CREATE TABLE IF NOT EXISTS sk2_biz_bills (
    id UUID PRIMARY KEY, store_id UUID NOT NULL REFERENCES sk2_biz_stores(id) ON DELETE CASCADE, week BIGINT NOT NULL, kind TEXT NOT NULL CHECK (kind IN ('alvara','iptu','iss')),
    amount INT NOT NULL, fine INT NOT NULL DEFAULT 0, due_at TIMESTAMPTZ NOT NULL, paid_at TIMESTAMPTZ, paid_day BIGINT, UNIQUE (store_id, week, kind));
  CREATE INDEX IF NOT EXISTS sk2_biz_bills_store ON sk2_biz_bills(store_id, paid_at);
  CREATE TABLE IF NOT EXISTS sk2_biz_bag (
    username TEXT NOT NULL REFERENCES sk2_players(username) ON DELETE CASCADE, item_id TEXT NOT NULL, qty INT NOT NULL CHECK (qty >= 0), PRIMARY KEY (username, item_id));`);
}
